{
  "manifest_version": 3,
  "name": "Sonora — An Ambient Sound Mixer",
  "version": "1.0.0",
  "description": "A minimal ambient sound mixer for calm focus.",
  "action": {
    "default_title": "Sonora",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["offscreen", "storage"]
}
